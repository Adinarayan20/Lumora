# ─────────────────────────────────────────────────────────────────────────────
# Lumora Backend — Environment Variable Reference
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Use the pooler endpoint for production.
DATABASE_URL=postgresql://user:password@localhost:5432/lumora

# ── Authentication ────────────────────────────────────────────────────────────
# Minimum 32 chars. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-secure-random-string-minimum-32-chars
JWT_REFRESH_SECRET=replace-with-different-secure-random-string-minimum-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Application ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
SHUTDOWN_TIMEOUT_MS=10000

# ── OAuth (optional — remove if not using OAuth login) ────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# ── File Storage (optional — defaults to LOCAL) ───────────────────────────────
# STORAGE_PROVIDER=LOCAL
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=
# R2_ACCOUNT_ID=

# ── Observability (optional) ──────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=lumora-backend
# LOG_LEVEL=info
