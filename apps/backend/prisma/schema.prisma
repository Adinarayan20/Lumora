generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

enum WorkspacePlan {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum WorkspaceMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id String @id @default(uuid()) @db.Uuid

  email    String @unique
  username String @unique

  displayName String

  passwordHash String

  avatarUrl String?

  timezone String @default("UTC")
  locale   String @default("en")

  emailVerified Boolean @default(false)

  onboardingDone Boolean @default(false)

  status UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceMemberships WorkspaceMember[]
  ownedWorkspaces      Workspace[]       @relation("WorkspaceOwner")

  devices       Device[]
  sessions      Session[]
  oauthAccounts OAuthAccount[]

  uploadedFiles FileAsset[]
  auditLogs     AuditLog[]
  events        Event[]

  @@index([email])
  @@index([username])
}

//////////////////////////////////////////////////////
// WORKSPACE
//////////////////////////////////////////////////////

model Workspace {
  id String @id @default(uuid()) @db.Uuid

  name String

  slug String @unique

  plan WorkspacePlan @default(FREE)

  ownerId String @db.Uuid

  owner User @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  members WorkspaceMember[]

  roles Role[]

  spaces Space[]
}

//////////////////////////////////////////////////////
// MEMBER
//////////////////////////////////////////////////////

model WorkspaceMember {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String @db.Uuid

  userId String @db.Uuid

  roleId String @db.Uuid

  status WorkspaceMemberStatus @default(ACTIVE)

  joinedAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  user User @relation(fields: [userId], references: [id])

  role Role @relation(fields: [roleId], references: [id])

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

//////////////////////////////////////////////////////
// ROLE
//////////////////////////////////////////////////////

model Role {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String @db.Uuid

  name String

  description String?

  system Boolean @default(false)

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  members WorkspaceMember[]

  permissions RolePermission[]

  @@unique([workspaceId, name])
}

//////////////////////////////////////////////////////
// PERMISSION
//////////////////////////////////////////////////////

model Permission {
  id String @id @default(uuid()) @db.Uuid

  key String @unique

  resource String

  action String

  description String?

  roles RolePermission[]
}

//////////////////////////////////////////////////////
// ROLE PERMISSION
//////////////////////////////////////////////////////

model RolePermission {
  roleId String @db.Uuid

  permissionId String @db.Uuid

  role Role @relation(fields: [roleId], references: [id])

  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

enum DevicePlatform {
  WEB
  WINDOWS
  MACOS
  LINUX
  ANDROID
  IOS
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum OAuthProvider {
  GOOGLE
  GITHUB
  MICROSOFT
  APPLE
}

enum FileProvider {
  LOCAL
  S3
  CLOUDINARY
  R2
  GCS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

enum EventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SpaceType {
  PERSONAL
  TEAM
  SHARED
}

enum ObjectType {
  NOTE
  TASK
  REMINDER
  EVENT
}

enum ReminderStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ReminderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

model Device {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  name String

  platform DevicePlatform

  appVersion String?

  osVersion String?

  pushToken String?

  trusted Boolean @default(false)

  lastSeenAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  sessions Session[]

  @@index([userId])
}

model Session {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  deviceId String @db.Uuid

  accessToken String

  refreshToken String

  expiresAt DateTime

  status SessionStatus @default(ACTIVE)

  ipAddress String?

  userAgent String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  device Device @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@index([deviceId])
}

model OAuthAccount {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  provider OAuthProvider

  providerAccountId String

  accessToken String?

  refreshToken String?

  expiresAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model FileAsset {
  id String @id @default(uuid()) @db.Uuid

  uploadedById String @db.Uuid

  provider FileProvider

  bucket String?

  path String

  filename String

  mimeType String

  size Int

  checksum String?

  createdAt DateTime @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([uploadedById])
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  entity String

  entityId String

  action AuditAction

  oldData Json?

  newData Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Event {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  type String

  payload Json

  status EventStatus @default(PENDING)

  createdAt DateTime @default(now())

  processedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SearchIndex {
  id String @id @default(uuid()) @db.Uuid

  entity String

  entityId String

  title String

  content String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([entity])
  @@index([entityId])
}

model Space {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String @db.Uuid

  name String

  type SpaceType

  color String?

  icon String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  objects Object[]

  @@index([workspaceId])
}

model Object {
  id String @id @default(uuid()) @db.Uuid

  spaceId String @db.Uuid

  title String

  description String?

  type ObjectType

  archived Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  space Space @relation(fields: [spaceId], references: [id])

  reminder Reminder?

  timeline Timeline?

  @@index([spaceId])
}

model Reminder {
  id String @id @default(uuid()) @db.Uuid

  objectId String @unique @db.Uuid

  status ReminderStatus @default(ACTIVE)

  priority ReminderPriority @default(MEDIUM)

  remindAt DateTime

  completedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  object Object @relation(fields: [objectId], references: [id])

  notifications Notification[]
}

model Notification {
  id String @id @default(uuid()) @db.Uuid

  reminderId String @db.Uuid

  title String

  body String

  scheduledFor DateTime

  deliveredAt DateTime?

  status NotificationStatus @default(PENDING)

  reminder Reminder @relation(fields: [reminderId], references: [id])

  @@index([reminderId])
}

model Timeline {
  id String @id @default(uuid()) @db.Uuid

  objectId String @unique @db.Uuid

  startedAt DateTime

  endedAt DateTime?

  timezone String

  object Object @relation(fields: [objectId], references: [id])
}
