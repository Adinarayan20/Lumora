generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

enum WorkspacePlan {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum WorkspaceType {
  PERSONAL
  CUSTOM
  FAMILY
  TEAM
  BUSINESS
}

enum WorkspaceVisibility {
  PRIVATE
  INTERNAL
  PUBLIC
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  DELETED
}

enum WorkspaceMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id String @id @default(uuid()) @db.Uuid

  email    String @unique
  username String @unique

  displayName String

  passwordHash String

  avatarUrl String?

  timezone String @default("UTC")
  locale   String @default("en")

  emailVerified Boolean @default(false)

  onboardingDone Boolean @default(false)

  status UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceMemberships WorkspaceMember[]
  ownedWorkspaces      Workspace[]       @relation("WorkspaceOwner")
  sentInvitations      WorkspaceInvitation[] @relation("InvitedBy")

  devices       Device[]
  sessions      Session[]
  oauthAccounts OAuthAccount[]

  uploadedFiles FileAsset[]
  auditLogs     AuditLog[]
  events        Event[]
  objectsCreated Object[] @relation("ObjectAuthor")
  objectsUpdated Object[] @relation("ObjectModifier")
  spacesCreated  Space[]  @relation("SpaceAuthor")
  spacesUpdated  Space[]  @relation("SpaceModifier")
  collectionsCreated Collection[] @relation("CollectionAuthor")
  collectionsUpdated Collection[] @relation("CollectionModifier")
  remindersCreated  Reminder[]   @relation("ReminderAuthor")
  remindersUpdated  Reminder[]   @relation("ReminderModifier")
  remindersDismissed Reminder[]  @relation("ReminderDismissedBy")

  @@index([email])
  @@index([username])
}

//////////////////////////////////////////////////////
// WORKSPACE
//////////////////////////////////////////////////////

model Workspace {
  id String @id @default(uuid()) @db.Uuid

  name String

  slug String @unique

  description String?

  icon String?

  emoji String?

  cover String?

  color String?

  type WorkspaceType @default(CUSTOM)

  visibility WorkspaceVisibility @default(PRIVATE)

  status WorkspaceStatus @default(ACTIVE)

  plan WorkspacePlan @default(FREE)

  ownerId String @db.Uuid

  settings Json?

  billingId String?

  deletedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  owner User @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  members WorkspaceMember[]

  roles Role[]

  spaces Space[]

  invitations WorkspaceInvitation[]

  objects Object[]

  collections Collection[]

  reminders Reminder[]
}

//////////////////////////////////////////////////////
// MEMBER
//////////////////////////////////////////////////////

model WorkspaceMember {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String @db.Uuid

  userId String @db.Uuid

  roleId String? @db.Uuid

  status WorkspaceMemberStatus @default(ACTIVE)

  joinedAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  user User @relation(fields: [userId], references: [id])

  role Role? @relation(fields: [roleId], references: [id])

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

//////////////////////////////////////////////////////
// INVITATION
//////////////////////////////////////////////////////

model WorkspaceInvitation {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String @db.Uuid

  email String

  roleId String? @db.Uuid

  invitedById String @db.Uuid

  token String @unique

  status InvitationStatus @default(PENDING)

  expiresAt DateTime

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  invitedBy User @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([workspaceId])
  @@index([email])
}

//////////////////////////////////////////////////////
// ROLE
//////////////////////////////////////////////////////

model Role {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String @db.Uuid

  name String

  description String?

  system Boolean @default(false)

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  members WorkspaceMember[]

  permissions RolePermission[]

  @@unique([workspaceId, name])
}

//////////////////////////////////////////////////////
// PERMISSION
//////////////////////////////////////////////////////

model Permission {
  id String @id @default(uuid()) @db.Uuid

  key String @unique

  resource String

  action String

  description String?

  roles RolePermission[]
}

//////////////////////////////////////////////////////
// ROLE PERMISSION
//////////////////////////////////////////////////////

model RolePermission {
  roleId String @db.Uuid

  permissionId String @db.Uuid

  role Role @relation(fields: [roleId], references: [id])

  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

enum DevicePlatform {
  WEB
  WINDOWS
  MACOS
  LINUX
  ANDROID
  IOS
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum OAuthProvider {
  GOOGLE
  GITHUB
  MICROSOFT
  APPLE
}

enum FileProvider {
  LOCAL
  S3
  CLOUDINARY
  R2
  GCS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

enum EventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SpaceType {
  PERSONAL
  TEAM
  SHARED
}

enum SpaceStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum CollectionType {
  STATIC
  DYNAMIC
}

enum CollectionStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum ObjectType {
  NOTE
  TASK
  REMINDER
  EVENT
}

enum ObjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum ReminderTriggerType {
  TIME
  LOCATION
  WEBHOOK
  AI
  AUTOMATION
}

enum ReminderSource {
  MANUAL
  AI
  AUTOMATION
  CALENDAR
  IMPORT
  API
}

enum ReminderStatus {
  ACTIVE
  SNOOZED
  COMPLETED
  CANCELLED
  DISMISSED
  DELETED
}

enum ReminderExecutionStatus {
  PENDING
  TRIGGERED
  SNOOZED
  COMPLETED
  MISSED
}

enum ReminderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

model Device {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  name String

  platform DevicePlatform

  appVersion String?

  osVersion String?

  pushToken String?

  trusted Boolean @default(false)

  lastSeenAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  sessions Session[]

  @@index([userId])
}

model Session {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  deviceId String @db.Uuid

  accessToken String

  refreshToken String

  expiresAt DateTime

  status SessionStatus @default(ACTIVE)

  ipAddress String?

  userAgent String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  device Device @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@index([deviceId])
}

model OAuthAccount {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  provider OAuthProvider

  providerAccountId String

  accessToken String?

  refreshToken String?

  expiresAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model FileAsset {
  id String @id @default(uuid()) @db.Uuid

  uploadedById String @db.Uuid

  provider FileProvider

  bucket String?

  path String

  filename String

  mimeType String

  size Int

  checksum String?

  createdAt DateTime @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([uploadedById])
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  entity String

  entityId String

  action AuditAction

  oldData Json?

  newData Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Event {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  type String

  payload Json

  status EventStatus @default(PENDING)

  createdAt DateTime @default(now())

  processedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SearchIndex {
  id String @id @default(uuid()) @db.Uuid

  entity String

  entityId String

  title String

  content String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([entity])
  @@index([entityId])
}

model Space {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String @db.Uuid

  parentId String? @db.Uuid

  createdById String @db.Uuid

  updatedById String? @db.Uuid

  slug String

  name String

  description String?

  icon String?

  emoji String?

  cover String?

  color String?

  pinnedAt DateTime?

  isFavorite Boolean @default(false)

  status SpaceStatus @default(ACTIVE)

  settings Json? @default("{}")

  revision Int @default(1)

  archivedAt DateTime?

  deletedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  parent Space? @relation("SpaceHierarchy", fields: [parentId], references: [id], onDelete: Restrict)

  children Space[] @relation("SpaceHierarchy")

  createdBy User @relation("SpaceAuthor", fields: [createdById], references: [id])

  updatedBy User? @relation("SpaceModifier", fields: [updatedById], references: [id])

  objects Object[]

  @@index([workspaceId, slug])
  @@index([workspaceId, status])
  @@index([workspaceId, parentId])
  @@index([workspaceId, isFavorite])
  @@index([workspaceId, pinnedAt])
  @@index([createdById])
}

model Object {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String @db.Uuid

  spaceId String? @db.Uuid

  createdById String @db.Uuid

  updatedById String? @db.Uuid

  objectKey String @default(uuid())

  typeKey String

  title String

  description String?

  icon String?

  emoji String?

  cover String?

  color String?

  pinnedAt DateTime?

  isFavorite Boolean @default(false)

  status ObjectStatus @default(ACTIVE)

  systemData Json? @default("{}")

  attributes Json? @default("{}")

  revision Int @default(1)

  archivedAt DateTime?

  deletedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  space Space? @relation(fields: [spaceId], references: [id])

  createdBy User @relation("ObjectAuthor", fields: [createdById], references: [id])

  updatedBy User? @relation("ObjectModifier", fields: [updatedById], references: [id])

  reminders Reminder[]

  timeline Timeline[]

  collectionItems CollectionItem[]

  @@index([workspaceId, objectKey])
  @@index([workspaceId, status])
  @@index([workspaceId, typeKey])
  @@index([workspaceId, isFavorite])
  @@index([workspaceId, pinnedAt])
  @@index([spaceId])
  @@index([createdById])
  @@index([updatedById])
}

model Reminder {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String @db.Uuid

  objectId String @db.Uuid

  createdById String @db.Uuid

  updatedById String? @db.Uuid

  dismissedById String? @db.Uuid

  lastExecutionId String?

  source ReminderSource @default(MANUAL)

  triggerType ReminderTriggerType @default(TIME)

  status ReminderStatus @default(ACTIVE)

  executionStatus ReminderExecutionStatus @default(PENDING)

  remindAt DateTime

  snoozedUntil DateTime?

  nextOccurrenceAt DateTime?

  lastTriggeredAt DateTime?

  completedAt DateTime?

  dismissedAt DateTime?

  cancelledAt DateTime?

  deletedAt DateTime?

  timezone String @default("UTC")

  recurrenceRule String?

  priority ReminderPriority?

  recurrence Json?

  revision Int @default(1)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  object Object @relation(fields: [objectId], references: [id], onDelete: Cascade)

  createdBy User @relation("ReminderAuthor", fields: [createdById], references: [id])

  updatedBy User? @relation("ReminderModifier", fields: [updatedById], references: [id])

  dismissedBy User? @relation("ReminderDismissedBy", fields: [dismissedById], references: [id])

  notifications Notification[]

  executions ReminderExecution[]

  @@index([workspaceId, nextOccurrenceAt, executionStatus])
  @@index([executionStatus, nextOccurrenceAt])
  @@index([objectId, status])
  @@index([workspaceId, objectId])
  @@index([workspaceId, createdById])
  @@index([workspaceId, status])
}

model ReminderExecution {
  id String @id @default(uuid()) @db.Uuid

  reminderId String @db.Uuid

  scheduledFor DateTime

  executedAt DateTime @default(now())

  status ReminderExecutionStatus @default(TRIGGERED)

  executionId String @unique

  errorMessage String?

  durationMs Int?

  createdAt DateTime @default(now())

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([reminderId])
  @@index([status])
}

model Notification {
  id String @id @default(uuid()) @db.Uuid

  reminderId String @db.Uuid

  title String

  body String

  scheduledFor DateTime

  deliveredAt DateTime?

  status NotificationStatus @default(PENDING)

  reminder Reminder @relation(fields: [reminderId], references: [id])

  @@index([reminderId])
}

model Timeline {
  id String @id @default(uuid()) @db.Uuid

  objectId String @db.Uuid

  startedAt DateTime

  endedAt DateTime?

  timezone String

  workspaceId String? @db.Uuid

  userId String? @db.Uuid

  action String?

  metadata Json?

  object Object @relation(fields: [objectId], references: [id])

  @@index([workspaceId])
  @@index([userId])
  @@index([action])
}

model Collection {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String @db.Uuid

  createdById String @db.Uuid

  updatedById String? @db.Uuid

  slug String

  name String

  description String?

  type CollectionType @default(STATIC)

  query Json?

  icon String?

  emoji String?

  cover String?

  color String?

  pinnedAt DateTime?

  isFavorite Boolean @default(false)

  status CollectionStatus @default(ACTIVE)

  settings Json? @default("{}")

  revision Int @default(1)

  archivedAt DateTime?

  deletedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  createdBy User @relation("CollectionAuthor", fields: [createdById], references: [id])

  updatedBy User? @relation("CollectionModifier", fields: [updatedById], references: [id])

  items CollectionItem[]

  @@index([workspaceId, slug])
  @@index([workspaceId, status])
  @@index([workspaceId, isFavorite])
  @@index([workspaceId, pinnedAt])
  @@index([createdById])
}

model CollectionItem {
  id String @id @default(uuid()) @db.Uuid

  collectionId String @db.Uuid

  objectId String @db.Uuid

  order Int @default(0)

  addedAt DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  object Object @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([collectionId, objectId])
  @@index([collectionId])
  @@index([objectId])
}

//////////////////////////////////////////////////////
// TEMPLATES & INSTALLED TEMPLATES
//////////////////////////////////////////////////////

enum InstalledTemplateStatus {
  DRAFT
  VALIDATING
  INSTALLING
  ACTIVE
  UPGRADED
  ROLLING_BACK
  FAILED
  DISABLED
  UNINSTALLING
  ARCHIVED
  DEPRECATED
}

model Template {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  packageUuid String   @default(uuid())
  publisherUuid String @default(uuid())
  packageHash String
  manifest    Json
  content     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model InstalledTemplate {
  id               String                  @id @default(uuid()) @db.Uuid
  workspaceId      String                  @db.Uuid
  templateKey      String
  installedVersion String
  status           InstalledTemplateStatus @default(ACTIVE)
  installedAt      DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([workspaceId, templateKey])
  @@index([workspaceId])
  @@index([templateKey])
}

